# Example environment configuration
# Copy this file to .env.local for local development

# Application Configuration
# VITE_APP_NAME=Secure Frontend Console
# VITE_APP_VERSION=1.0.0

# Feature Flags
# VITE_ENABLE_LOGGING=true

# Development Settings
# VITE_DEV_MODE=true

# Note: This application intentionally does not use secrets or API keys
# All configuration is client-side and non-sensitive
